<GuiXml>
  <Controls>
    <!-- Opt-in button shown near the interaction window -->
    <TopLevelControl name="GAFE_QuestAutomationOptInButton" hidden="true" mouseEnabled="true" clampedToScreen="true">
      <Dimensions x="300" y="40" />
      <Anchor point="BOTTOMLEFT" relativeTo="ZO_InteractWindow" relativePoint="TOPLEFT" offsetX="0" offsetY="-10" />

      <OnInitialized>
        GAFE_QuestAutomationUI_OnInitialized(self)
      </OnInitialized>

      <Controls>
        <Button name="$(parent)Button" inherits="ZO_KeybindButton">
          <Anchor point="LEFT" />
          <OnClicked>
            GAFE_QuestAutomationUI_OnButtonClicked()
          </OnClicked>
        </Button>
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>
